@model QuoteViewModel
@{
    ViewData["Title"] = "Quotes";
}

<div class="container-fluid mt-4">

    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2 class="mb-0">Quotes List</h2>

        <div class="d-flex gap-2">
            <button class="btn btn-outline-secondary" id="refreshBtn" onclick="refreshAll()"
                    title="Re-query Sage Intacct for the latest quotes">
                Refresh
            </button>

            <a class="btn btn-primary" asp-controller="Quote" asp-action="Create">
                New Quote
            </a>
        </div>
    </div>

    <table id="quotesTable" class="table table-bordered table-hover align-middle bg-white">
        <thead class="table-dark">
            <tr>
                <th>Key</th>
                <th>Quote Number</th>
                <th>Customer</th>
                <th>Address</th>
                <th>External Order #</th>
                <th>Order Date</th>
                <th>Due Date</th>
                <th>Invoice Date</th>
                <th style="width: 220px;">Actions</th>
            </tr>
        </thead>

        <tbody>
            @foreach (var q in Model.Quotes)
            {
                <tr data-key="@q.Key">

                    <!-- hidden, used for sorting newest-first -->
                    <td>@q.Key</td>

                    <td data-search="@q.QuoteNumber" data-order="@q.QuoteNumber">
                        <input class="form-control" value="@q.QuoteNumber" disabled />
                    </td>

                    <td data-search="@q.CustomerName" data-order="@q.CustomerName">
                        <input class="form-control" value="@($"{q.CustomerId} - {q.CustomerName}")" disabled />
                    </td>

                    <td data-search="@q.Address" data-order="@q.Address">
                        <input class="form-control" value="@q.Address" disabled />
                    </td>

                    <td data-search="@q.ExternalOrderNumber" data-order="@q.ExternalOrderNumber">
                        <input class="form-control externalOrderNumber" value="@q.ExternalOrderNumber" />
                    </td>

                    <td data-search="@q.TransactionDate?.ToString("yyyy/MM/dd")" data-order="@q.TransactionDate?.ToString("yyyy/MM/dd")">
                        <input type="date" class="form-control transactionDate"
                               value="@q.TransactionDate?.ToString("yyyy-MM-dd")" />
                    </td>

                    <td data-search="@q.DueDate?.ToString("yyyy/MM/dd")" data-order="@q.DueDate?.ToString("yyyy/MM/dd")">
                        <input type="date" class="form-control dueDate"
                               value="@q.DueDate?.ToString("yyyy-MM-dd")" />
                    </td>

                    <td data-search="@q.InvoiceDate?.ToString("yyyy/MM/dd")" data-order="@q.InvoiceDate?.ToString("yyyy/MM/dd")">
                        <input type="date" class="form-control invoiceDate"
                               value="@q.InvoiceDate?.ToString("yyyy-MM-dd")" />
                    </td>

                    <!-- Actions -->
                    <td>
                        <button class="btn btn-sm btn-success" onclick="updateQuote(this)">
                            Save
                        </button>

                        <button class="btn btn-sm btn-danger" onclick="deleteQuote(this)">
                            Delete
                        </button>

                        <button class="btn btn-sm btn-primary" onclick="viewQuoteLines(this)">
                            View
                        </button>
                    </td>

                </tr>
            }
        </tbody>
    </table>
</div>

@section Scripts {

<!-- jQuery, Bootstrap and DataTables are all loaded from _Layout.cshtml. -->
<script>

    $(document).ready(function () {

        $('#quotesTable').DataTable({

            pageLength: 20,

            lengthMenu: [
                [20, 50, 100, -1],
                [20, 50, 100, "All"]
            ],

            responsive: true,

            stateSave: true,

            autoWidth: false,

            order: [[1, "desc"]], // Quote Number, newest first

            language: {
                search: "Search:",
                searchPlaceholder: "Search quotes..."
            },

            columnDefs: [
                {
                    visible: false,
                    targets: 0 // Key column (hidden, sort key only)
                },
                {
                    orderable: false,
                    targets: 8 // Actions column
                }
            ]

        });

    });

    function refreshAll() {
        const btn = document.getElementById("refreshBtn");

        btn.disabled = true;
        btn.innerHTML = '<span class="spinner-border spinner-border-sm me-2"></span>Refreshing...';

        fetch("/Lookup/Refresh", { method: "POST" })
            .then(async res => {
                if (!res.ok) throw new Error(await res.text());
                window.location.reload();
            })
            .catch(err => {
                btn.disabled = false;
                btn.textContent = "Refresh";
                alert(err.message);
            });
    }

    function getRowData(btn) {
        const row = btn.closest("tr");

        return {
            key: row.dataset.key,
            externalOrderNumber: row.querySelector(".externalOrderNumber").value,
            transactionDate: row.querySelector(".transactionDate").value || null,
            dueDate: row.querySelector(".dueDate").value || null,
            invoiceDate: row.querySelector(".invoiceDate").value || null
        };
    }

    function refreshCell(input, searchValue, orderValue) {
        const td = input.closest("td");

        td.setAttribute("data-search", searchValue ?? "");
        td.setAttribute("data-order", orderValue ?? "");

        $('#quotesTable').DataTable().cell(td).invalidate();
    }

    function flashRow(row) {
        row.classList.add("table-success");
        setTimeout(() => row.classList.remove("table-success"), 1200);
    }

    function setBusy(btn, busy) {
        if (busy) {
            btn.dataset.label = btn.innerHTML;
            btn.disabled = true;
            btn.innerHTML = '<span class="spinner-border spinner-border-sm"></span>';
        }
        else {
            btn.disabled = false;
            btn.innerHTML = btn.dataset.label;
        }
    }

    function updateQuote(btn) {
        const row = btn.closest("tr");
        const data = getRowData(btn);

        setBusy(btn, true);

        fetch("/Quote", {
            method: "PUT",
            headers: {
                "Content-Type": "application/json"
            },
            body: JSON.stringify(data)
        })
        .then(async res => {
            if (!res.ok) {
                const msg = await res.text();
                throw new Error(`Update failed (${res.status}): ${msg}`)
            }

            refreshCell(row.querySelector(".externalOrderNumber"), data.externalOrderNumber, data.externalOrderNumber);
            refreshCell(row.querySelector(".transactionDate"), data.transactionDate?.replaceAll("-", "/"), data.transactionDate?.replaceAll("-", "/"));
            refreshCell(row.querySelector(".dueDate"), data.dueDate?.replaceAll("-", "/"), data.dueDate?.replaceAll("-", "/"));
            refreshCell(row.querySelector(".invoiceDate"), data.invoiceDate?.replaceAll("-", "/"), data.invoiceDate?.replaceAll("-", "/"));

            $('#quotesTable').DataTable().draw(false);

            flashRow(row);
        })
        .catch(err => alert(err.message))
        .finally(() => setBusy(btn, false));
    }

    function deleteQuote(btn) {
        const row = btn.closest("tr");
        const key = row.dataset.key;

        if (!confirm("Are you sure you want to delete this quote in Sage Intacct?")) return;

        setBusy(btn, true);

        fetch(`/Quote/${encodeURIComponent(key)}`, {
            method: "DELETE"
        })
        .then(async res => {
            if (!res.ok) {
                const msg = await res.text();
                throw new Error(`Delete failed (${res.status}): ${msg}`);
            }

            $('#quotesTable').DataTable().row(row).remove().draw(false);
        })
        .catch(err => {
            alert(err.message);
            setBusy(btn, false);
        });
    }

    function viewQuoteLines(btn) {
        const row = btn.closest("tr");
        const key = row.dataset.key;

        window.location.href = `/QuoteLine/?quoteKey=${encodeURIComponent(key)}`;
    }
</script>
}
